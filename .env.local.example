# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it contains secrets.

# Public site URL — used for canonical links, sitemap.xml, robots.txt,
# and Open Graph tags. Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Optional — from analytics.google.com. Leave blank to skip analytics
# entirely; the tracking script only loads when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# From Google Cloud Console > APIs & Services > Credentials
# This OAuth client must have BOTH scopes enabled in your consent
# screen config: Calendar (calendar.readonly) and Gmail (gmail.readonly)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# NextAuth requires a secret used to encrypt session JWTs.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-generated-32-char-secret

# The base URL of your app (used for OAuth callbacks)
NEXTAUTH_URL=http://localhost:3000

# URL for the Python LLM service used by chat, query, and decision generation.
# It should accept POST JSON and return {"text":"...", "tool_calls":[]}.
PYTHON_LLM_URL=http://localhost:8000/generate
PYTHON_LLM_MODEL=vyris-local
PYTHON_LLM_API_KEY=

# Optional URL for the Python transcription endpoint. It should accept a
# multipart "file" upload and return {"text":"..."}.
PYTHON_LLM_TRANSCRIBE_URL=http://localhost:8000/transcribe
PYTHON_LLM_TRANSCRIBE_MODEL=vyris-transcriber

# Postgres connection string. For Neon/Supabase/Railway, copy the
# connection string from their dashboard. For local Postgres:
# postgresql://USER:PASSWORD@localhost:5432/vyris
DATABASE_URL=
# From resend.com — used for team invite emails AND real "Email" mode
# messages sent from the Team page. Without this, both features still
# work as in-app actions, just no email actually goes out.
RESEND_API_KEY=
# Required for sending to anyone other than your own Resend account
# email — set this to an address on a domain you'vyris verified in Resend
# (Domains tab). Format: "Vyris <name@yourdomain.com>"
RESEND_FROM_EMAIL=
