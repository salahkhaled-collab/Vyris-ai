generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── NextAuth required models ───────────────────────────────────

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Vyris domain models ─────────────────────────────────────────

enum Role {
  CEO
  FOUNDER
  EXECUTIVE
  MANAGER
  OTHER
}

enum AccessLevel {
  ADMIN
  MEMBER
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

model User {
  memories      Memory[]
  snapshots     WorkspaceSnapshot[]
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? //new

  role            Role?
  accessLevel     AccessLevel    @default(MEMBER)
  dashboardLayout String[]       @default([])
  workspaceType   WorkspaceType?
  onboarded       Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  sentMessages TeamMessage[] @relation("MessageAuthor")
  sentInvites  Invite[]      @relation("InviteSender")

  ownedProjects   Project[]        @relation("ProjectOwner")
  ownedTasks      Task[]           @relation("TaskOwner")
  assignedTasks   Task[]           @relation("TaskAssignee")
  contacts        Contact[]        @relation("ContactOwner")
  documents       Document[]       @relation("DocumentOwner")
  decisions       Decision[]       @relation("DecisionOwner")
  objectives      Objective[]      @relation("ObjectiveOwner")
  strategicBets   StrategicBet[]   @relation("StrategicBetOwner")
  automationRules AutomationRule[] @relation("AutomationRuleOwner")
  risks           Risk[]           @relation("RiskOwner")
  aiConversations AiConversation[]
  linkedEmails    ProjectEmail[]   @relation("ProjectEmailLinker")

  @@index([teamId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members       User[]
  messages      TeamMessage[]
  invites       Invite[]
  projects      Project[]
  contacts      Contact[]
  documents     Document[]
  decisions     Decision[]
  objectives    Objective[]
  strategicBets StrategicBet[]
  risks         Risk[]
}

model TeamMessage {
  id        String   @id @default(cuid())
  content   String   @db.Text
  channel   String   @default("message") // "message" | "email"
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  recipientId String?

  @@index([teamId, createdAt])
}

model Invite {
  id        String @id @default(cuid())
  token     String @unique @default(cuid())
  teamId    String
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy String
  inviter   User   @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)

  email       String?
  role        Role?
  accessLevel AccessLevel @default(MEMBER)

  status     String   @default("pending")
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  acceptedBy String?

  @@index([teamId, status])
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  tasks     Task[]
  documents Document[]
  emails    ProjectEmail[]

  @@index([ownerId])
  @@index([teamId])
}

/// A Gmail thread the user saved to a project. Only metadata (subject, sender,
/// snippet) is kept; the body stays in Gmail. Visible to anyone who can see the project.
model ProjectEmail {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  threadId   String
  messageId  String
  subject    String
  fromName   String
  fromEmail  String?
  snippet    String   @db.Text
  receivedAt DateTime
  linkedById String
  linkedBy   User     @relation("ProjectEmailLinker", fields: [linkedById], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([projectId, threadId])
  @@index([projectId, receivedAt])
}

enum DecisionStatus {
  OPEN
  DECIDED
}

model Decision {
  id             String         @id @default(cuid())
  title          String
  context        String         @db.Text
  deadline       String
  status         DecisionStatus @default(OPEN)
  recommendation String?        @db.Text
  chosenOptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("DecisionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  options DecisionOption[]

  @@index([ownerId])
  @@index([teamId])
}

model DecisionOption {
  id    String   @id @default(cuid())
  label String
  score Int
  pros  String[]
  cons  String[]

  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}

model Objective {
  id      String @id @default(cuid())
  title   String
  quarter String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("ObjectiveOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  keyResults KeyResult[]
  tasks      Task[]

  @@index([ownerId])
  @@index([teamId])
}

model KeyResult {
  id      String @id @default(cuid())
  label   String
  current Float
  target  Float
  unit    String @default("")

  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
}

enum BetStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

model StrategicBet {
  id      String    @id @default(cuid())
  title   String
  signal  String    @db.Text
  horizon String
  status  BetStatus @default(ON_TRACK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("StrategicBetOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  tasks Task[]

  @@index([ownerId])
  @@index([teamId])
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATING
  RESOLVED
}

model Risk {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  severity    RiskSeverity @default(MEDIUM)
  status      RiskStatus   @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  @@index([ownerId])
  @@index([teamId])
}

enum RuleStatus {
  ACTIVE
  PAUSED
}

model AutomationRule {
  id      String     @id @default(cuid())
  name    String
  trigger String     @db.Text
  action  String     @db.Text
  status  RuleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("AutomationRuleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  runs AutomationRun[]

  @@index([ownerId])
  @@index([status, trigger])
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

/// One execution of a rule. dedupeKey stops a rule firing twice for the same
/// thing (e.g. "overdue" for the same task every day).
model AutomationRun {
  id        String              @id @default(cuid())
  ruleId    String
  rule      AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dedupeKey String
  status    AutomationRunStatus
  detail    String              @db.Text
  createdAt DateTime            @default(now())

  @@unique([ruleId, dedupeKey])
  @@index([ruleId, createdAt])
}

model Task {
  id      String     @id @default(cuid())
  title   String
  status  TaskStatus @default(TODO)
  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Who is responsible for doing the task. Null means "the owner" — a solo
  // user never sets this, so existing rows and solo workflows are unchanged.
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Only meaningful while status is BLOCKED; cleared when the task is unblocked.
  blockedReason String? @db.Text

  // Drift Signals: a task optionally points at ONE of these two —
  // enforced in the API layer, not the DB (Prisma has no native XOR constraint).
  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  strategicBetId String?
  strategicBet   StrategicBet? @relation(fields: [strategicBetId], references: [id], onDelete: SetNull)

  @@index([assigneeId])
  @@index([projectId])
  @@index([ownerId])
  @@index([objectiveId])
  @@index([strategicBetId])
}

model Contact {
  id      String  @id @default(cuid())
  name    String
  email   String?
  phone   String?
  company String?
  role    String?
  notes   String? @db.Text
  tag     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  @@index([ownerId])
  @@index([teamId])
}

model Document {
  id        String @id @default(cuid())
  filename  String
  mimeType  String
  sizeBytes Int
  data      Bytes

  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  @@index([ownerId])
  @@index([teamId])
  @@index([projectId])
}

model AiConversation {
  id        String   @id @default(cuid())
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  messages AiMessage[]

  @@index([ownerId, updatedAt])
}

model AiMessage {
  id        String   @id @default(cuid())
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Someone who asked for early access on /waitlist. Not a user account.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  company   String?
  /// Where they came from (utm_source or ref), if the link carried one.
  source    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Fixed-window counters for abuse limits (login attempts, invites, signups).
/// Keys look like "login:<email>" or "invite:<userId>". Safe to empty at any time.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
}

/// One row per user per day: the numbers behind "unusual changes".
/// Written by the daily cron and when risk signals are loaded.
model WorkspaceSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD" (UTC)
  day          String
  openTasks    Int
  overdue      Int
  blocked      Int
  doneLast7    Int
  createdLast7 Int
  createdAt    DateTime @default(now())

  @@unique([userId, day])
}
